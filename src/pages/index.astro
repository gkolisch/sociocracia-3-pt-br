---
import Base from '../layouts/Base.astro';
import { categorias, tituloPorSlug } from '../data/padroes';
import situacoes from '../data/situacoes.json';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const totalPadroes = categorias.reduce((n, c) => n + c.padroes.length, 0);

const explorar = [
  { href: 'abertura/', titulo: 'O que é S3', desc: 'Conceitos, princípios e práticas.' },
  { href: 'principios/', titulo: 'Os sete princípios', desc: 'A base da colaboração sociocrática e ágil.' },
  { href: 'conceitos-chave/', titulo: 'Conceitos-chave', desc: 'Propósito, motivadores, domínios, governança.' },
  { href: 'common-sense-framework/', titulo: 'Framework de senso comum', desc: 'Por onde começar.' },
  { href: 'glossario/', titulo: 'Glossário', desc: 'Termos do S3, com o original em inglês.' },
];
---

<Base title="Início">
  <h1>Sociocracia 3.0</h1>
  <p class="lede">
    Um guia prático para evoluir organizações ágeis e resilientes. Tradução em português do Brasil,
    com {totalPadroes} padrões em {categorias.length} categorias.
  </p>

  <h2>Comece por situação</h2>
  <p>O que vocês precisam fazer agora? Se for a primeira reunião, comece pelo <a href={`${base}primeira-reuniao/`}>roteiro de primeira reunião</a>.</p>
  <div class="situacoes">
    {
      situacoes.map((s) => (
        <section class="situacao">
          <h3>{s.titulo}</h3>
          <ul>
            {s.slugs.map((slug) => (
              <li>
                <a href={`${base}padroes/${slug}/`}>{tituloPorSlug[slug] ?? slug}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <h2>Os padrões</h2>
  <p>Todos os {totalPadroes} padrões, com filtro por texto e por categoria.</p>
  <p><a class="qa-btn" href={`${base}padroes/`}>Ver todos os {totalPadroes} padrões</a></p>

  <h2>Explorar</h2>
  <div class="cards">
    {
      explorar.map((e) => (
        <a class="card" href={`${base}${e.href}`}>
          <h3>{e.titulo}</h3>
          <p>{e.desc}</p>
        </a>
      ))
    }
  </div>
</Base>

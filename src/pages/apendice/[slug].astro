---
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const titulos: Record<string, string> = {
  'exemplo-de-descricao-de-dominio-marketing': 'Exemplo de descrição de domínio: departamento de marketing',
  icpt: 'ICPT — Compromisso intencional de praticantes e professores',
  licenca: 'Licença',
  links: 'Links',
  'aviso-legal': 'Aviso legal',
  agradecimentos: 'Agradecimentos',
  autores: 'Autores',
};

export async function getStaticPaths() {
  const itens = await getCollection('apendice');
  return itens.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'apendice'>;
}

const { entry } = Astro.props;
const titulo = titulos[entry.id] ?? entry.id;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
---

<Base title={titulo}>
  <p class="breadcrumb"><a href={`${base}apendice/`}>Apêndice</a></p>
  <article class="doc"><Content /></article>
</Base>

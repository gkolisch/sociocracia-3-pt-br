---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
---

<Base title="Assistente">
  <h1>Busca assistida</h1>
  <p class="lede">Encontre no guia os trechos que respondem à sua pergunta. Não é uma IA que conversa: é uma busca que mostra o que o guia diz.</p>
  <p class="nota">Roda inteiro no seu navegador. Nenhuma pergunta sai daqui e não precisa de conta.</p>

  <form id="qa-form" class="qa-form" autocomplete="off">
    <input id="qa-input" class="qa-input" type="search" placeholder="Ex.: como decidir em grupo sem votar?" aria-label="Sua pergunta" />
    <button class="qa-btn" type="submit">Perguntar</button>
  </form>

  <p class="nota">Exemplos:
    <button type="button" class="chip" data-exemplo="como decidir em grupo sem votar">decidir sem votar</button>
    <button type="button" class="chip" data-exemplo="como conduzir a primeira reunião">primeira reunião</button>
    <button type="button" class="chip" data-exemplo="como definir papéis e círculos">definir papéis</button>
    <button type="button" class="chip" data-exemplo="o que fazer quando o grupo trava">grupo travado</button>
  </p>

  <div id="qa-out" class="qa-out" aria-live="polite"></div>

  <script>
    const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
    const form = document.getElementById('qa-form');
    const input = document.getElementById('qa-input');
    const out = document.getElementById('qa-out');
    let pf = null;
    let carregando = null;
    let erroCarga = null;

    const importar = new Function('u', 'return import(u)');
    const esc = (s) =>
      String(s).replace(
        /[&<>"']/g,
        (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
      );
    const comLimite = (p, ms) =>
      Promise.race([
        p,
        new Promise((_, rejeitar) => setTimeout(() => rejeitar(new Error('tempo esgotado')), ms)),
      ]);

    async function carregar() {
      if (pf) return pf;
      if (carregando) return carregando;
      carregando = (async () => {
        try {
          pf = await importar(`${base}pagefind/pagefind.js`);
          try {
            await comLimite(pf.init(), 15000);
          } catch {}
        } catch (erro) {
          pf = null;
          erroCarga = erro;
          console.error('assistente: falha ao carregar o pagefind', erro);
        }
        return pf;
      })();
      return carregando;
    }

    function renderResultados(consulta, resultados) {
      if (!resultados.length) {
        out.innerHTML = `<p class="qa-vazio">Nada encontrado para "<strong>${esc(consulta)}</strong>". Tente outras palavras ou use a <a href="${base}busca/">busca completa</a>.</p>`;
        return;
      }
      const partes = [`<p class="qa-titulo">Trechos do guia que respondem a "${esc(consulta)}":</p>`];
      for (const r of resultados) {
        const d = r;
        const titulo = d.meta?.title ?? 'Página';
        partes.push(`
          <article class="qa-card">
            <a class="qa-card-title" href="${esc(d.url)}">${esc(titulo)}</a>
            <p class="qa-excerpt">${d.excerpt}</p>
          </article>
        `);
      }
      out.innerHTML = partes.join('');
      out.setAttribute('tabindex', '-1');
      out.focus();
    }

    function fallbackBusca() {
      out.innerHTML = '<p class="qa-titulo">Não deu para montar o assistente agora. Use a busca:</p><div id="qa-fallback"></div>';
      const iniciar = () => {
        try {
          new window.PagefindUI({
            element: '#qa-fallback',
            showSubResults: true,
            placeholder: 'Buscar…',
            translations: {
              placeholder: 'Buscar…',
              clear_search: 'Limpar',
              load_more: 'Carregar mais resultados',
              search_label: 'Buscar neste site',
              filters_label: 'Filtros',
              zero_results: 'Nenhum resultado para [SEARCH_TERM]',
              many_results: '[COUNT] resultados para [SEARCH_TERM]',
              one_result: '[COUNT] resultado para [SEARCH_TERM]',
              searching: 'Buscando [SEARCH_TERM]…',
            },
          });
        } catch (e) {
          out.innerHTML = '<p class="qa-vazio">A busca também não carregou. Recarregue a página.</p>';
        }
      };
      if (!document.querySelector(`link[href*="pagefind-ui.css"]`)) {
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = `${base}pagefind/pagefind-ui.css`;
        document.head.appendChild(css);
      }
      if (window.PagefindUI) return iniciar();
      const script = document.createElement('script');
      script.src = `${base}pagefind/pagefind-ui.js`;
      script.onload = iniciar;
      script.onerror = () => {
        out.innerHTML = '<p class="qa-vazio">A busca também não carregou. Recarregue a página.</p>';
      };
      document.head.appendChild(script);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const consulta = input.value.trim();
      if (!consulta) return;
      out.innerHTML = '<p class="qa-carregando">Procurando no guia…</p>';
      try {
        const paginafind = await comLimite(carregar(), 20000);
        if (!paginafind) {
          throw new Error(erroCarga ? `não carregou o índice (${erroCarga.message})` : 'índice indisponível');
        }
        const busca = await comLimite(paginafind.search(consulta), 25000);
        const resultados = await Promise.all(busca.results.slice(0, 5).map((r) => r.data()));
        renderResultados(consulta, resultados);
      } catch (erro) {
        console.error('assistente:', erro);
        fallbackBusca();
      }
    });

    for (const chip of document.querySelectorAll('.chip[data-exemplo]')) {
      chip.addEventListener('click', () => {
        input.value = chip.dataset.exemplo;
        form.requestSubmit();
      });
    }
  </script>
</Base>

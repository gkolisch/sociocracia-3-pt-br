---
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { tituloPorSlug, categoriaPorSlug, todosPadroes } from '../../data/padroes';

export async function getStaticPaths() {
  const padroes = await getCollection('padroes');
  return padroes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'padroes'>;
}

const { entry } = Astro.props;
const titulo = tituloPorSlug[entry.id] ?? entry.id;
const categoria = categoriaPorSlug[entry.id];
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';

const indice = todosPadroes.findIndex((p) => p.slug === entry.id);
const anterior = indice > 0 ? todosPadroes[indice - 1] : null;
const proximo = indice >= 0 && indice < todosPadroes.length - 1 ? todosPadroes[indice + 1] : null;
---

<Base title={titulo}>
  {
    categoria && (
      <p class="breadcrumb">
        <a href={`${base}padroes/#${categoria.id}`}>{categoria.titulo}</a>
        <span> · {tituloPorSlug[entry.id] ? '' : ''}</span>
      </p>
    )
  }
  <article class="doc"><Content /></article>

  <nav class="padnav" aria-label="Navegação entre padrões">
    {
      anterior ? (
        <a class="padnav-link anterior" href={`${base}padroes/${anterior.slug}/`}>
          <span>Anterior</span>
          {anterior.titulo}
        </a>
      ) : (
        <span />
      )
    }
    {
      proximo ? (
        <a class="padnav-link proximo" href={`${base}padroes/${proximo.slug}/`}>
          <span>Próximo</span>
          {proximo.titulo}
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</Base>
